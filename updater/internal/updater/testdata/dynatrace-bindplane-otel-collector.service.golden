[Unit]
Description=Dynatrace Bindplane Distribution of OpenTelemetry Collector
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5
[Service]
Type=simple
User=root
Group=dbdot
Environment=PATH=/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=BINDPLANE_COLLECTOR_HOME=/opt/dynatrace-bindplane-otel-collector
Environment=BINDPLANE_COLLECTOR_STORAGE=/opt/dynatrace-bindplane-otel-collector/storage
WorkingDirectory=/opt/dynatrace-bindplane-otel-collector
ExecStart=/opt/dynatrace-bindplane-otel-collector/dynatrace-bindplane-otel-collector --config config.yaml
LimitNOFILE=65000
SuccessExitStatus=0
TimeoutSec=20
StandardOutput=journal
Restart=on-failure
RestartSec=5s
KillMode=process
[Install]
WantedBy=multi-user.target 
